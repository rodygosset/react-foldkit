{
	"name": "react-foldkit-monorepo",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "bun run test:lint && eslint . && turbo lint",
		"test:lint": "node --test eslint/function-style.test.mjs",
		"format": "turbo format",
		"typecheck": "turbo typecheck",
		"test": "turbo test"
	},
	"devDependencies": {
		"@typescript-eslint/parser": "8.66.0",
		"eslint": "9.39.5",
		"eslint-plugin-react": "^7.37.5",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"turbo": "^2.9.18",
		"typescript": "^6"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=20.19.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
