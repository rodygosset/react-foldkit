{
	"name": "react-foldkit-monorepo",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "bun run test:lint && NODE_OPTIONS=\"--import ./eslint/ts6-register.mjs\" eslint . && oxlint . --ignore-pattern 'repos/**' --max-warnings=0 && turbo lint",
		"lint:effect": "effect-tsgo diagnostics --project packages/react-foldkit/tsconfig.json",
		"test:lint": "node --import ./eslint/ts6-register.mjs --test eslint/function-style.test.mjs",
		"format": "turbo format",
		"typecheck": "turbo typecheck",
		"test": "turbo test",
		"prepare": "effect-tsgo patch --typescript --oxlint"
	},
	"devDependencies": {
		"@effect/tsgo": "0.50.0",
		"@typescript-eslint/parser": "8.66.0",
		"eslint": "9.39.5",
		"eslint-plugin-react": "^7.37.5",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"turbo": "^2.9.18",
		"typescript": "^7",
		"typescript6": "npm:typescript@6.0.3"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=20.19.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
