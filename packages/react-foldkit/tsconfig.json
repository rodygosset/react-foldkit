{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"ignoreDeprecations": "6.0"
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"eslint/src/**/*.ts",
		"vitest.config.ts",
		"vitest.setup.ts",
		"tsup.config.ts",
		"tsup.eslint.config.ts"
	],
	"exclude": ["node_modules", "dist", "eslint/dist"]
}
