{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"paths": {
			"@workspace/react-foldkit/*": ["./src/*"]
		}
	},
	"include": ["."],
	"exclude": ["node_modules", "dist"]
}
