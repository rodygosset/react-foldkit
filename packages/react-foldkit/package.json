{
	"name": "react-foldkit",
	"version": "0.1.0",
	"description": "React TEA bindings over Foldkit vocabulary (Command, Message, Update, Subscription, AsyncData).",
	"type": "module",
	"license": "MIT",
	"author": "Rody Gosset",
	"keywords": [
		"react",
		"tea",
		"elm-architecture",
		"effect",
		"foldkit"
	],
	"scripts": {
		"build": "tsup && tsup --config tsup.eslint.config.ts",
		"prepack": "bun run build",
		"lint": "eslint",
		"format": "prettier --write \"**/*.{ts,tsx}\"",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"test:package": "bun run build && vitest run --config vitest.package.config.ts",
		"test:types:package": "tsc --project test/types/tsconfig.json",
		"coverage": "vitest run --coverage",
		"pack:dry": "bun run build && npm pack --dry-run",
		"test:types:example": "tsc --project examples/project-cache/tsconfig.json"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js"
		},
		"./asyncData": {
			"types": "./dist/asyncData.d.ts",
			"import": "./dist/asyncData.js"
		},
		"./command": {
			"types": "./dist/command.d.ts",
			"import": "./dist/command.js"
		},
		"./message": {
			"types": "./dist/message.d.ts",
			"import": "./dist/message.js"
		},
		"./query": {
			"types": "./dist/query.d.ts",
			"import": "./dist/query.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"import": "./dist/schema.js"
		},
		"./store": {
			"types": "./dist/store.d.ts",
			"import": "./dist/store.js"
		},
		"./struct": {
			"types": "./dist/struct.d.ts",
			"import": "./dist/struct.js"
		},
		"./subscription": {
			"types": "./dist/subscription.d.ts",
			"import": "./dist/subscription.js"
		},
		"./update": {
			"types": "./dist/update.d.ts",
			"import": "./dist/update.js"
		},
		"./eslint": {
			"types": "./eslint/dist/index.d.ts",
			"import": "./eslint/dist/index.js",
			"default": "./eslint/dist/index.js"
		},
		"./commitSource": {
			"types": "./dist/commitSource.d.ts",
			"import": "./dist/commitSource.js"
		},
		"./loader": {
			"types": "./dist/loader.d.ts",
			"import": "./dist/loader.js"
		},
		"./tanstack": {
			"types": "./dist/tanstack.d.ts",
			"import": "./dist/tanstack.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"eslint/dist",
		"eslint/README.md",
		"LICENSE",
		"README.md",
		"CHANGELOG.md",
		"THIRD-PARTY-NOTICES.md"
	],
	"peerDependencies": {
		"effect": "4.0.0-rc.117",
		"eslint": "^9",
		"react": "^19.2.6",
		"@tanstack/react-router": "^1.170.33",
		"@tanstack/router-core": "^1.171.28",
		"@tanstack/react-store": "^0.9.3"
	},
	"peerDependenciesMeta": {
		"eslint": {
			"optional": true
		},
		"@tanstack/react-router": {
			"optional": true
		},
		"@tanstack/router-core": {
			"optional": true
		},
		"@tanstack/react-store": {
			"optional": true
		}
	},
	"dependencies": {
		"foldkit": "0.164.0",
		"picomatch": "^4.0.5",
		"use-sync-external-store": "1.6.0"
	},
	"devDependencies": {
		"@effect/vitest": "4.0.0-rc.117",
		"@tanstack/react-router": "1.170.33",
		"@tanstack/react-store": "0.9.3",
		"@tanstack/router-core": "1.171.28",
		"@testing-library/react": "^16.3.2",
		"@types/estree": "^1.0.8",
		"@types/picomatch": "^4.0.3",
		"@types/react": "^19",
		"@types/react-dom": "^19.2.4",
		"@types/use-sync-external-store": "1.5.0",
		"@vitest/browser-playwright": "5.0.3",
		"@vitest/coverage-v8": "5.0.3",
		"effect": "4.0.0-rc.117",
		"eslint": "^9",
		"happy-dom": "^20.10.4",
		"playwright": "^1.61.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"tsup": "^8.5.0",
		"typescript": "^6",
		"vite": "8.2.0",
		"vitest": "5.0.3"
	}
}
